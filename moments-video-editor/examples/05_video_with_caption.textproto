# Case: 1 video + captions.
# Two sequential captions on a caption track (a simple subtitle sequence). The
# second uses karaoke-style per-word timing.

schema_version: 1
profile: DOCUMENT_PROFILE_AUTHORING

canvas {
  aspect_ratio: ASPECT_RATIO_9_16
  fps: 30
  post_type: POST_TYPE_VIDEO
}

timeline {
  duration_ms: 8000

  tracks {
    track_id: "main"
    kind: TRACK_KIND_MAIN_VIDEO
    z_order: 0
    elements {
      element_id: "e_clip1"
      timeline_range { start_ms: 0 duration_ms: 8000 }
      media { asset_ref: "clip1" fit_mode: FIT_MODE_COVER }
    }
  }

  tracks {
    track_id: "captions"
    kind: TRACK_KIND_CAPTION
    z_order: 20
    elements {
      element_id: "e_cap1"
      timeline_range { start_ms: 500 duration_ms: 3000 }
      caption {
        text: "Welcome to my world"
        preset: CAPTION_PRESET_BOLD_HIGHLIGHT
        style {
          font_family: "Inter"
          font_size: 0.06
          text_color { r: 1 g: 1 b: 1 a: 1 }
          background_color { r: 0 g: 0 b: 0 a: 0.4 }
          bold: true
          align: TEXT_ALIGN_CENTER
        }
        transform {
          position { x: 0.5 y: 0.85 }
          anchor { x: 0.5 y: 0.5 }
          scale { x: 1 y: 1 }
          opacity: 1
        }
      }
    }
    elements {
      element_id: "e_cap2"
      timeline_range { start_ms: 3800 duration_ms: 3500 }
      caption {
        text: "let the adventure begin"
        preset: CAPTION_PRESET_KARAOKE
        style {
          font_family: "Inter"
          font_size: 0.06
          text_color { r: 1 g: 1 b: 1 a: 1 }
          bold: true
          align: TEXT_ALIGN_CENTER
        }
        transform {
          position { x: 0.5 y: 0.85 }
          anchor { x: 0.5 y: 0.5 }
          scale { x: 1 y: 1 }
          opacity: 1
        }
        # Per-word timings are relative to this element's start.
        word_timings { word: "let"       start_ms: 0    end_ms: 400 }
        word_timings { word: "the"       start_ms: 400  end_ms: 700 }
        word_timings { word: "adventure" start_ms: 700  end_ms: 1700 }
        word_timings { word: "begin"     start_ms: 1700 end_ms: 2600 }
      }
    }
  }
}

assets {
  key: "clip1"
  value {
    type: ASSET_TYPE_VIDEO
    global_asset_id: "rbxassetid://1001"
    duration_ms: 8000
  }
}
