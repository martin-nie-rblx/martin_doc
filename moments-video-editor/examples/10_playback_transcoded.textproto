# Case: PLAYBACK profile — the simplified consumption output for example 06
# (video + music + caption), AFTER transcoding.
#
# Everything heavy (the clip, its trims, the muted embedded audio, and the
# music mix) has been baked into ONE transcoded composite asset, so it appears
# as a single MediaSegment with no edit parameters. The caption is kept LIVE as
# an overlay element (so it can be toggled / restyled by the player) — note it
# reuses the exact same Caption/Element messages as the authoring document.
#
# Compare to 06_video_with_music_and_caption.textproto: same model, far fewer
# fields populated.

schema_version: 1
profile: DOCUMENT_PROFILE_PLAYBACK

canvas {
  aspect_ratio: ASPECT_RATIO_9_16
  fps: 30
  post_type: POST_TYPE_VIDEO
}

timeline {
  duration_ms: 10000

  # The whole composite (video + music) baked into one transcoded asset.
  tracks {
    track_id: "main"
    kind: TRACK_KIND_MAIN_VIDEO
    z_order: 0
    elements {
      element_id: "e_composite"
      timeline_range { start_ms: 0 duration_ms: 10000 }
      media { asset_ref: "composite" fit_mode: FIT_MODE_COVER }
    }
  }

  # Optional: a caption left live for accessibility / toggling.
  tracks {
    track_id: "captions"
    kind: TRACK_KIND_CAPTION
    z_order: 20
    elements {
      element_id: "e_cap1"
      timeline_range { start_ms: 1000 duration_ms: 4000 }
      caption {
        text: "best day ever ☀️"
        preset: CAPTION_PRESET_BOLD_HIGHLIGHT
        style {
          font_family: "Inter"
          font_size: 0.07
          text_color { r: 1 g: 1 b: 1 a: 1 }
          stroke { color { r: 0 g: 0 b: 0 a: 1 } width: 2.0 }
          bold: true
          align: TEXT_ALIGN_CENTER
        }
        transform {
          position { x: 0.5 y: 0.8 }
          anchor { x: 0.5 y: 0.5 }
          scale { x: 1 y: 1 }
          opacity: 1
        }
      }
    }
  }
}

# Just the resolved, network-adaptive transcoded output. No local sources, no
# catalog entries, no generators — every binding is a global_asset_id.
assets {
  key: "composite"
  value {
    type: ASSET_TYPE_VIDEO
    global_asset_id: "rbxassetid://9009"
    duration_ms: 10000
  }
}
