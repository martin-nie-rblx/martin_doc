# Case: 1 video + 1 audio (background music).
# A music track plays under the video; the video's own embedded audio is muted.

schema_version: 1
profile: DOCUMENT_PROFILE_AUTHORING

canvas {
  aspect_ratio: ASPECT_RATIO_9_16
  fps: 30
  post_type: POST_TYPE_VIDEO
}

timeline {
  duration_ms: 8000

  tracks {
    track_id: "main"
    kind: TRACK_KIND_MAIN_VIDEO
    z_order: 0
    elements {
      element_id: "e_clip1"
      timeline_range { start_ms: 0 duration_ms: 8000 }
      media {
        asset_ref: "clip1"
        fit_mode: FIT_MODE_COVER
        embedded_audio { muted: true }
      }
    }
  }

  tracks {
    track_id: "music"
    kind: TRACK_KIND_AUDIO
    z_order: 0
    volume: 1.0
    elements {
      element_id: "e_music"
      timeline_range { start_ms: 0 duration_ms: 8000 }
      audio {
        asset_ref: "song1"
        kind: AUDIO_KIND_MUSIC
        # Use the first 8s of the song.
        source_trim { in_point_ms: 0 out_point_ms: 8000 }
        properties {
          volume: 0.8
          fade_in_ms: 300
          fade_out_ms: 800
        }
        display_title: "Sunset Drive — The Examples"
      }
    }
  }
}

assets {
  key: "clip1"
  value {
    type: ASSET_TYPE_VIDEO
    global_asset_id: "rbxassetid://1001"
    duration_ms: 8000
  }
}
assets {
  key: "song1"
  value {
    type: ASSET_TYPE_AUDIO
    catalog { catalog_id: "music/sunset-drive" kind: CATALOG_KIND_MUSIC }
    duration_ms: 180000
  }
}
